<?xml version="1.0" encoding="UTF-8"?>
<!--
    This app is packaged as a WAR and deployed to an external Tomcat (Azure App Service).
    server.servlet.session.timeout in application.properties only applies to the embedded
    Tomcat used in local runs, so without this file production falls back to Tomcat's
    default 30-minute session timeout - which expired sessions at the exact moment the
    30-minute class test auto-submit fired. Keep this value in sync with application.properties.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Session timeout in minutes (matches server.servlet.session.timeout=210m) -->
    <session-config>
        <session-timeout>210</session-timeout>
    </session-config>

</web-app>
